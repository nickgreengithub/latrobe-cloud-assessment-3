# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committed
!.env.example

# vercel
.vercel

# course materials (not part of the submission codebase)
/module_1
/module_2
/module_3
/marking_criteria_*.png
/assignment_*_instructions.md
/assignment_*_instructions.png
/Assessment*.docx
/Archive.zip
/links.txt
/assessment_3

# prisma — local database file, never committed
/prisma/*.db
/prisma/*.db-journal
/data

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# local sqlite database (recreated by `npm run db:migrate && npm run db:seed`)
/dev.db
/dev.db-journal

# Playwright output (reports are regenerated; traces are large)
/test-results
/playwright-report
/blob-report
/playwright/.cache

# JMeter's own internal logs — the .jtl results and summary are the evidence
/load/results/*.log

# Personal preparation notes — not part of the submitted codebase
/VIDEO_SCRIPT.md
/ASSESSMENT_4_STUDY.md
